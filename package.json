{
  "name": "ts-eslint-starter",
  "version": "1.0.0",
  "description": "A simple starter kit for TypeScript and ESLint.",
  "scripts": {
    "build": "npm run lint --silent && npm run typecheck --silent && tsup",
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint --silent -- --fix",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "author": "HiveSolution",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.14",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
